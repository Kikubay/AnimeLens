# Public build configuration only. Never put API keys or client secrets here.
VITE_APP_ENV=development
# Public MAL client ID registered for this extension. Never add a client secret.
VITE_MAL_CLIENT_ID=
# Public AniList client ID registered for this extension (OAuth2 implicit grant).
# Register the app at https://anilist.co/settings/developer with the extension
# redirect URL (chrome.identity.getRedirectURL()). Never add a client secret.
VITE_ANILIST_CLIENT_ID=
