{
  "name": "animelens",
  "version": "0.1.9",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Recommendation dashboard for MyAnimeList and AniList, as a Chrome extension and a desktop app.",
  "author": {
    "name": "Kikubay",
    "email": "150976767+Kikubay@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kikubay/AnimeLens.git"
  },
  "homepage": "https://github.com/Kikubay/AnimeLens",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "npm run typecheck && npm run build:extension && npm run build:electron",
    "build:extension": "npm run build:extension:chromium && npm run build:extension:gecko && npm run build:extension:package",
    "build:extension:chromium": "vite build --mode production",
    "build:extension:gecko": "vite build --config vite.extension.gecko.config.ts --mode production",
    "build:extension:package": "node scripts/package-extension.mjs",
    "build:electron": "npm run build:electron:node && npm run build:electron:renderer && npm run build:electron:package",
    "build:electron:node": "vite build --config vite.electron.node.config.ts --mode production",
    "build:electron:renderer": "vite build --config vite.electron.renderer.config.ts --mode production",
    "build:electron:package": "electron-builder --config electron-builder.yml --publish never",
    "start:electron": "electron dist/electron/app/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"*.{json,js,mjs,ts,yml}\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
