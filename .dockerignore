# The image builds from source, so anything regenerated by `npm ci` or `vite build` is dead weight.
node_modules
dist

# Local build configuration is machine specific, and the image is built with no client IDs at all.
.env.development
.env.production

.git
.github
.gitattributes
.gitignore

# Reference material and release scratch space, none of it an input to the desktop build.
docs
build
demo
tests
ponytail
.opencode
.DO_NOT_PUBLISH